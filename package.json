{
  "name": "create-nodejs-express-app",
  "version": "1.7.0",
  "description": "Create a Node.js app for building production-ready RESTful APIs using Express, by running one command",
  "bin": "bin/createNodejsApp.js",
  "main": "src/index.js",
  "repository": "https://github.com/hagopj13/node-express-boilerplate.git",
  "author": "Hagop Jamkojian <hagopj13@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "node --check api/index.js && node --check src/serverless.js",
    "start": "node src/index.js",
    "dev": "cross-env NODE_ENV=development nodemon src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check **/*.js",
    "prettier:fix": "prettier --write **/*.js",
    "prepare": "node scripts/prepare.cjs"
  },
  "keywords": [
    "express",
    "mongoose",
    "vercel",
    "garantias"
  ],
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "cross-env": "^7.0.0",
    "dotenv": "^18.0.8",
    "express": "5.3.0",
    "express-mongo-sanitize": "^2.0.0",
    "express-rate-limit": "^8.7.1",
    "formidable": "^3.5.1",
    "helmet": "^8.3.0",
    "http-status": "^1.4.0",
    "joi": "^18.3.0",
    "jsdom": "^30.1.3",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.24.0",
    "mongoose": "9.11.2",
    "morgan": "^1.9.1",
    "nodemailer": "^10.1.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "svg-to-pdfkit": "^0.1.8",
    "swagger-jsdoc": "^6.0.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.2.0",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "xss-filters": "1.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "eslint": "10.13.0",
    "globals": "latest",
    "husky": "7.0.4",
    "jest": "30.5.2",
    "lint-staged": "^17.6.0",
    "mongodb-memory-server": "11.3.0",
    "nock": "14.0.17",
    "node-mocks-http": "^1.8.0",
    "nodemon": "^3.1.14",
    "prettier": "^2.0.5",
    "supertest": "7.3.1"
  },
  "packageManager": "npm@11.19.1"
}
